{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/data/(.*)",
      "dest": "http://47.103.71.89/data/$1"
    },
    {
  "src": "/proxy/(.*)",
  "dest": "http://47.103.71.89/api/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/admin",
      "dest": "/public/admin.html"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/dev123",
      "dest": "/public/devdao123.html"
    },
    {
      "src": "/devdao",
      "dest": "/public/devdao.html"
    },
    {
      "src": "/dev",
      "dest": "/public/devstake.html"
    },
    {
      "src": "/devstake",
      "dest": "/public/devlend.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
